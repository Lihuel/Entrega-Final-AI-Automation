    {
      "parameters": {
        "jsCode": "const consultas = $input.all();\n\nconst totalIngresadas = consultas.length;\n\nconst aprobadas = consultas.filter(item =>\n  item.json.fields?.[\"Aprobación\"] === \"Aprobado\"\n).length;\n\nconst rechazadas = consultas.filter(item =>\n  item.json.fields?.[\"Aprobación\"] === \"Rechazado\"\n).length;\n\nconst decididas = aprobadas + rechazadas;\n\n// 1. Tasa de aprobación\nconst tasaAprobacion = decididas > 0\n  ? (aprobadas / decididas) * 100\n  : 0;\n\n// 2. Volumen de salida\nconst volumenSalida = totalIngresadas > 0\n  ? (aprobadas / totalIngresadas) * 100\n  : 0;\n\nreturn [{\n  json: {\n    total_ingresadas: totalIngresadas,\n    aprobadas_humano: aprobadas,\n    rechazadas_humano: rechazadas,\n    tasa_aprobacion: Number(tasaAprobacion.toFixed(1)),\n    volumen_salida: Number(volumenSalida.toFixed(1))\n  }\n}];\n"
      },
