    {
      "parameters": {
        "jsCode": "const ejecuciones = $('Traer Ejecuciones').all();\nconst errores = $('Traer Errores').all();\n\nconst tasaError = ejecuciones.length > 0\n  ? (errores.length / ejecuciones.length) * 100\n  : 0;\n\nreturn [{\n  json: {\n    total_ejecuciones: ejecuciones.length,\n    total_errores: errores.length,\n    tasa_error: Number(tasaError.toFixed(1))\n  }\n}];\n"
      },
